{
  "name": "feud",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "dotenv -e .env.local -- sh -c \"NODE_OPTIONS='--import ./instrument.server.mjs' vite dev --port 3000 --host\"",
    "generate-routes": "tsr generate",
    "build": "vite build && cp instrument.server.mjs .output/server",
    "preview": "vite preview",
    "test": "vitest run",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check",
    "start": "node --import ./.output/server/instrument.server.mjs .output/server/index.mjs",
    "gentypes": "dotenv -e .env.local -- sh -c 'supabase gen types typescript --db-url \"${DB_STRING}\" > src/types/supabase.types.ts'",
    "db:pull": "dotenv -e .env.local -- sh -c 'supabase db pull --db-url \"${DB_STRING}\"'",
    "db:push": "dotenv -e .env.local -- sh -c 'supabase db push --db-url \"${DB_STRING}\"'",
    "db:migration:new": "dotenv -e .env.local -- sh -c 'supabase migration new --db-url \"${DB_STRING}\"'",
    "db:migration:fetch": "dotenv -e .env.local -- sh -c 'supabase migration fetch --db-url \"${DB_STRING}\"'",
    "db:migration:repair": "dotenv -e .env.local -- sh -c 'supabase migration repair --db-url \"${DB_STRING}\"'"
  },
  "engines": {
    "node": "^24 || ^26"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@dnd-kit/abstract": "^0.5.0",
